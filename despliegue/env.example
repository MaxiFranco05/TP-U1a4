# ==============================================================================
# Variables de entorno para el contenedor Docker en el VPS (despliegue/env.example)
# Sin secretos ni valores reales en este archivo versionado
# ==============================================================================

# Dirección de conexión a PostgreSQL con driver asincrónico asyncpg
# Si PostgreSQL corre directamente en el servidor anfitrión, usar host.docker.internal:
# DATABASE_URL=postgresql+asyncpg://usuario:password@host.docker.internal:5432/nombre_base
DATABASE_URL=postgresql+asyncpg://usuario:password@servidor:5432/nombre_base

# Desactivar logs detallados de cada consulta SQL en producción
SQL_ECHO=false
