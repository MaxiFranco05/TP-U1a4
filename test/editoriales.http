### Configuración de Token para Rutas Protegidas (ADMIN)
@admin_token = rellenar_con_token_jwt_admin

### Create editorial - success (201, ADMIN)
POST http://localhost:8000/editoriales
Content-Type: application/json
Cookie: access_token={{admin_token}}

{
  "nombre": "Editorial Planeta",
  "pais": "España"
}

### Create editorial - duplicate name (409, ADMIN)
POST http://localhost:8000/editoriales
Content-Type: application/json
Cookie: access_token={{admin_token}}

{
  "nombre": "Editorial Planeta",
  "pais": "Argentina"
}

### List editoriales - default pagination (200, Público)
GET http://localhost:8000/editoriales

### List editoriales - custom pagination (200, Público)
GET http://localhost:8000/editoriales?page=1&size=5

### List editoriales - invalid size (422, Público)
GET http://localhost:8000/editoriales?size=101

### List editoriales - invalid page (422, Público)
GET http://localhost:8000/editoriales?page=0

### Get editorial by id - success (200, ADMIN)
GET http://localhost:8000/editoriales/1
Cookie: access_token={{admin_token}}

### Get editorial by id - not found (404, ADMIN)
GET http://localhost:8000/editoriales/999
Cookie: access_token={{admin_token}}

### Update editorial - success (200, ADMIN)
PATCH http://localhost:8000/editoriales/1
Content-Type: application/json
Cookie: access_token={{admin_token}}

{
  "pais": "España (actualizado)"
}

### Update editorial - duplicate name (409, ADMIN)
PATCH http://localhost:8000/editoriales/1
Content-Type: application/json
Cookie: access_token={{admin_token}}

{
  "nombre": "Editorial Sudamericana"
}

### Get libros by editorial - success (200, Público)
GET http://localhost:8000/editoriales/1/libros?page=1&size=10

### Get libros by editorial - not found (404, Público)
GET http://localhost:8000/editoriales/999/libros
