### Autenticación previa requerida (VENDEDOR o ADMIN para ventas, CLIENTE para mis-ventas y dueño)
@vend_cookie = access_token=PONER_TOKEN_VENDEDOR_AQUI
@cliente_cookie = access_token=PONER_TOKEN_CLIENTE_AQUI

### Create venta - happy path (1 line) → 201 (descuenta stock)
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    {
      "libro_id": 1,
      "cantidad": 2
    }
  ]
}

### Create venta - happy path (multiple lines) → 201 (descuenta stock de ambos libros)
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    {
      "libro_id": 1,
      "cantidad": 2
    },
    {
      "libro_id": 2,
      "cantidad": 1
    }
  ]
}

### Create venta - empty renglones → 422
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": []
}

### Create venta - duplicate libro_id → 422
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    {
      "libro_id": 1,
      "cantidad": 1
    },
    {
      "libro_id": 1,
      "cantidad": 2
    }
  ]
}

### Create venta - cantidad zero → 422
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    {
      "libro_id": 1,
      "cantidad": 0
    }
  ]
}

### Create venta - cantidad negative → 422
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    {
      "libro_id": 1,
      "cantidad": -1
    }
  ]
}

### Create venta - non-existent cliente → 409
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 99999,
  "renglones": [
    {
      "libro_id": 1,
      "cantidad": 1
    }
  ]
}

### Create venta - non-existent libro → 409
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    {
      "libro_id": 99999,
      "cantidad": 1
    }
  ]
}

### Create venta - stock insuficiente → 409 (rollback total)
POST http://localhost:8000/ventas/
Cookie: {{vend_cookie}}
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    {
      "libro_id": 1,
      "cantidad": 999999
    }
  ]
}

### Get venta by id - Vendedor (200)
GET http://localhost:8000/ventas/1
Cookie: {{vend_cookie}}

### Get venta by id - Cliente dueño (200)
GET http://localhost:8000/ventas/1
Cookie: {{cliente_cookie}}

### Get venta by id - not found (404)
GET http://localhost:8000/ventas/999
Cookie: {{vend_cookie}}

### List ventas - default pagination (200)
GET http://localhost:8000/ventas/
Cookie: {{vend_cookie}}

### List ventas - custom pagination (200)
GET http://localhost:8000/ventas/?page=1&size=5
Cookie: {{vend_cookie}}

### List ventas - invalid size (422)
GET http://localhost:8000/ventas/?size=101
Cookie: {{vend_cookie}}

### List ventas - invalid page (422)
GET http://localhost:8000/ventas/?page=0
Cookie: {{vend_cookie}}

### Mis Ventas - Ventas del cliente autenticado (200)
GET http://localhost:8000/mis-ventas/
Cookie: {{cliente_cookie}}

### Mis Ventas - Paginación inválida (422)
GET http://localhost:8000/mis-ventas/?page=999&size=10
Cookie: {{cliente_cookie}}
