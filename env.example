# Configuración de base de datos PostgreSQL 16 (sin credenciales reales en este archivo versionado)
# Puerto 5433 en desarrollo local cuando 5432 está ocupado en el host (ver compose.yaml y README.dev.md)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_en_entorno_local
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seguridad, JWT y hashing de contraseñas (obligatorio definir JWT_SECRET en .env)
JWT_SECRET=generar_con_python_secrets_token_hex_32
JWT_EXPIRATION_SECONDS=1800
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Pool de conexiones y trazas SQL
DB_POOL_SIZE=5
SQL_ECHO=false
