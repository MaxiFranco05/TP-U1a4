# URL de conexión asincrónica a PostgreSQL 16 (sin credenciales reales en este archivo de ejemplo)
# Puerto 5433 en desarrollo local cuando 5432 está ocupado en el host (ver compose.yaml y README.dev.md)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/libreria

# Mostrar consultas SQL emitidas por SQLAlchemy en consola (true/false)
SQL_ECHO=false
